load("@rules_jvm_external//:defs.bzl", "maven_export")
load("@wfa_rules_kotlin_jvm//kotlin:defs.bzl", "kt_jvm_library")
load("//build/maven:defs.bzl", "artifact_version")

package(default_visibility = ["//visibility:public"])

MAVEN_COORDINATES = "org.wfanet.measurement:common-throttler:" + artifact_version()

kt_jvm_library(
    name = "throttler",
    srcs = glob(["*.kt"]),
    tags = ["maven_coordinates=" + MAVEN_COORDINATES],
    deps = [
        "//imports/java/picocli",
        "//imports/kotlin/kotlinx/coroutines:core",
        "//src/main/kotlin/org/wfanet/measurement/common/ratelimit:token_bucket",
    ],
)

maven_export(
    name = "throttler_maven",
    lib_name = "throttler",
    maven_coordinates = MAVEN_COORDINATES,
    tags = ["no-javadocs"],
    visibility = ["//visibility:private"],
)
